{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "default_locale": "zh_CN",
  "name": "__MSG_extensionName__",
  "version": "0.2.13",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://hurry060215-tech.github.io/learnnote-assistant/",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "webNavigation",
    "cookies",
    "storage",
    "alarms",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
